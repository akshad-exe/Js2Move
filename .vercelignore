# Ignore all packages except frontend
packages/backend/
packages/cli/
packages/compiler/
packages/sdk/
packages/shared-types/

# Keep package.json files for workspace resolution
!packages/backend/package.json
!packages/cli/package.json
!packages/compiler/package.json
!packages/sdk/package.json
!packages/shared-types/package.json

# Ignore docs and other non-build files
docs/
docker/
infra/
scripts/
test-deployment/

# Ignore documentation files
*.md

# Ignore testing and config files that don't affect frontend
LICENSE
test-compile.js
POSTMAN_*.json
HBS_TEMPLATE_GUIDE.md

# Ignore all dotfiles and root config files except what Vercel needs
.*
!.env.example
!.env.local
!.gitignore

# Keep only frontend
!frontend/

