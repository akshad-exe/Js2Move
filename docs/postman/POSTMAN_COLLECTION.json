  "item": [
    {
      "name": "Compiler Endpoints",
      "description": "MoveJS compilation, validation, and analysis endpoints",
      "item": [
        {
          "name": "Compile MoveJS Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has success property', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('success');",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set('compiled_output', pm.response.json().output);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"module counter {\\n  resource Counter {\\n    value: u64\\n  }\\n\\n  public fun create(): Counter {\\n    return Counter { value: 0 };\\n  }\\n\\n  public fun increment(counter: &mut Counter) {\\n    counter.value = counter.value + 1;\\n  }\\n}\\n\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/public/compiler/compile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "public", "compiler", "compile"]
            }
          },
          "response": []
        },
        {
          "name": "Validate MoveJS Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has validation results', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"module token {\\n  resource Coin {\\n    value: u64,\\n    owner: address\\n  }\\n\\n  public fun mint(owner: address, amount: u64): Coin {\\n    return Coin { value: amount, owner: owner };\\n  }\\n}\\n\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/public/compiler/validate",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "public", "compiler", "validate"]
            }
          },
          "response": []
        },
        {
          "name": "Analyze MoveJS Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has analysis data', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"module nft {\\n  resource NFT {\\n    id: u64,\\n    owner: address,\\n    metadata: string\\n  }\\n\\n  public fun create(id: u64, owner: address, metadata: string): NFT {\\n    return NFT { id, owner, metadata };\\n  }\\n}\\n\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/public/compiler/analyze",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "public", "compiler", "analyze"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Gas Estimation Endpoints",
      "description": "Gas cost estimation endpoints",
      "item": [
        {
          "name": "Estimate Gas for Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has gas estimate', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('estimatedGas');",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    pm.environment.set('gas_estimate', data.estimatedGas);",
                  "    pm.environment.set('gas_price', data.gasPrice);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"module vault {\\n  resource Vault {\\n    balance: u64\\n  }\\n\\n  public fun deposit(vault: &mut Vault, amount: u64) {\\n    vault.balance = vault.balance + amount;\\n  }\\n}\\n\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/public/gas/estimate",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "public", "gas", "estimate"]
            }
          },
          "response": []
        },
        {
          "name": "Get Current Gas Price",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has gas price', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('gasPrice');",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set('current_gas_price', pm.response.json().gasPrice);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/public/gas/price",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "public", "gas", "price"]
            }
          },
          "response": []
        }
