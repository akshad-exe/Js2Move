            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"module marketplace {\\n  resource Listing {\\n    seller: address,\\n    item_id: u64,\\n    price: u64,\\n    active: bool\\n  }\\n\\n  public fun list_item(seller: address, item_id: u64, price: u64): Listing {\\n    return Listing { seller, item_id, price, active: true };\\n  }\\n}\\n\",\n  \"accountAddress\": \"0x1\",\n  \"network\": \"testnet\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/public/deploy",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "public", "deploy"]
            }
