# Frontend Environment Variables

# API Configuration
VITE_API_URL=http://localhost:8000/api/v1

# App Configuration
VITE_APP_NAME=Js2Move
VITE_APP_DESCRIPTION="Move smart contracts with JavaScript syntax"

# Analytics (optional)
VITE_ENABLE_ANALYTICS=false

# Wallet Configuration
VITE_WALLET_CONNECT_PROJECT_ID=your_wallet_connect_project_id

# Blockchain Configuration - Movement Network
VITE_APTOS_NETWORK=testnet
VITE_APTOS_NODE_URL=https://testnet.movementnetwork.xyz/v1
VITE_MOVEMENT_CHAIN_ID=250
VITE_MOVEMENT_FAUCET_URL=https://faucet.testnet.movementnetwork.xyz/

# Mainnet Configuration (uncomment for production)
# VITE_APTOS_NETWORK=mainnet
# VITE_APTOS_NODE_URL=https://mainnet.movementnetwork.xyz/v1
# VITE_MOVEMENT_CHAIN_ID=126
