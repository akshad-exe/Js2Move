{
    "name": "js2move",
    "private": true,
    "version": "0.0.0",
    "workspaces": [
        "packages/*",
        "frontend"
    ],
    "scripts": {
        "bootstrap": "pnpm -w install",
        "install:all": "pnpm -w install",
        "install:frontend": "pnpm -w -F frontend install",
        "install:backend": "pnpm -w -F @js2move/backend install",
        "install:compiler": "pnpm -w -F @js2move/compiler install",
        "install:contracts": "pnpm -w -F packages/contracts install",
        "dev": "pnpm -w -r --parallel run dev",
        "dev:backend": "pnpm --filter @js2move/backend dev",
        "dev:frontend": "pnpm --filter @js2move/frontend dev",
        "dev:cli": "pnpm --filter @js2move/cli dev",
        "build": "pnpm -w -r run build",
        "build:backend": "pnpm --filter @js2move/backend build",
        "build:frontend": "pnpm --filter @js2move/frontend build",
        "build:contracts": "pnpm --filter @js2move/contracts build",
        "build:compiler": "pnpm --filter @js2move/compiler build",
        "test": "pnpm -w -r run test",
        "test:backend": "pnpm --filter @js2move/backend test",
        "lint": "pnpm -w -r run lint",
        "lint:backend": "pnpm --filter @js2move/backend lint",
        "start:indexer": "pnpm --filter @js2move/backend start:indexer",
        "clean": "rimraf node_modules **/dist"
    },
    "devDependencies": {
        "rimraf": "^3.0.2",
        "tsconfig-paths": "^4.1.0"
    }
}