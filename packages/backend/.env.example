# Server
PORT=8000
NODE_ENV=development

# Database (if used)
# Local dev SQLite (uncomment to use):
# DATABASE_URL="file:./dev.db"
# Or Postgres for production:
DATABASE_URL=postgresql://user:password@localhost:5432/template_db

# Compiler settings (optional)
# e.g., path for compiler worker, timeouts, etc.
COMPILER_TIMEOUT_MS=5000
