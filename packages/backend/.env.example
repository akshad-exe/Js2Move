# ===========================================
# Js2Move Backend Environment Configuration
# ===========================================

# ===========================================
# SERVER CONFIGURATION
# ===========================================

# Server port (default: 3001)
PORT=8000

# Environment mode: development | production | test
NODE_ENV=development

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# Database connection URL
# For local development (SQLite):
# DATABASE_URL="file:./dev.db"
#
# For production (PostgreSQL):
DATABASE_URL=postgresql://user:password@localhost:5432/js2move_db

# ===========================================
# FEATURE FLAGS
# ===========================================

# Whether to start the blockchain indexer (default: false)
# Set to true only if you want to run the indexer process
START_INDEXER=false

# ===========================================
# CORS CONFIGURATION
# ===========================================

# Allowed origins for CORS requests
# Option 1: Comma-separated string (simpler)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app
#
# Option 2: JSON array (recommended for complex configurations)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://your-frontend.vercel.app"]

# Whether to allow credentials in CORS responses (default: false)
CORS_ALLOW_CREDENTIALS=false

# Preflight request cache duration in seconds (default: 86400 = 24 hours)
CORS_MAX_AGE=86400

# ===========================================
# BLOCKCHAIN CONFIGURATION
# ===========================================

# Aptos/Movement RPC endpoint URL
# Testnet: https://fullnode.testnet.aptoslabs.com/v1
# Mainnet: https://fullnode.mainnet.aptoslabs.com/v1
# Movement Testnet: https://testnet.movementnetwork.xyz/v1
RPC_ENDPOINT=https://testnet.movementnetwork.xyz/v1

# Blockchain network chain ID
# Aptos Testnet: 2
# Aptos Mainnet: 1
# Movement Testnet: 250
CHAIN_ID=250

# Private key for contract deployment (REQUIRED for deployment features)
# WARNING: Never commit this to version control!
# Generate a new keypair for production deployment
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Faucet URL for testnet token funding
# Aptos Testnet: https://faucet.testnet.aptoslabs.com/
# Movement Testnet: https://faucet.testnet.movementnetwork.xyz/
FAUCET_URL=https://faucet.testnet.movementnetwork.xyz/

# ===========================================
# DEVELOPMENT NOTES
# ===========================================

# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env files to version control
# 3. For production deployment, use secure secret management
# 4. Update CORS_ORIGINS with your actual frontend URLs
# 5. Generate new DEPLOYER_PRIVATE_KEY for production
