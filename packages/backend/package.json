{
  "name": "@js2move/backend",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
    "start": "node dist/index.js",
    "start:indexer": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/indexer/index.ts",
    "build": "tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev --name init --create-only",
    "prisma:studio": "prisma studio",
    "prisma:db:push": "prisma db push",
    "seed:examples": "ts-node prisma/seed-examples.ts",
    "test": "vitest",
    "lint": "eslint 'src/**' --fix"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^5.2.0",
    "@js2move/compiler": "workspace:*",
    "@js2move/shared-types": "workspace:*",
    "@prisma/client": "^5.1.0",
    "aptos": "^1.22.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-list-endpoints": "^2.0.0",
    "fs-extra": "^11.1.1",
    "helmet": "^6.0.0",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.8.2",
    "yamljs": "^0.3.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.17",
    "@types/express-list-endpoints": "^7.1.0",
    "@types/module-alias": "^2.0.4",
    "@types/morgan": "^1.9.3",
    "@types/node": "^18.19.130",
    "@types/supertest": "^2.0.12",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "dotenv": "^17.2.3",
    "eslint": "^8.0.0",
    "prisma": "^5.1.0",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.1.0",
    "typescript": "^5.2.0",
    "vite-tsconfig-paths": "^4.0.1",
    "vitest": "^1.0.0"
  }
}
