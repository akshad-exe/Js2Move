// 02-simple-token.movejs
// A basic fungible token implementation

/**
 * SimpleToken Contract
 * 
 * This contract implements a basic fungible token with:
 * - Balance tracking per address
 * - Transfer functionality
 * - Total supply management
 */
contract SimpleToken {
  // Resource to track token balances for each address
  resource Balance;

  // Resource to store total supply (stored at contract address)
  resource TotalSupply;

  /**
   * Initialize the token with initial supply
   * @param owner - The address that will receive the initial supply
   * @param initialSupply - The initial token supply
   */
  init(owner: address, initialSupply: u64) {
    // Set initial balance for owner
    Balance[owner] = initialSupply;
    
    // Store total supply
    TotalSupply[owner] = initialSupply;
  }

  /**
   * Transfer tokens from sender to recipient
   * @param from - The sender (must be signer)
   * @param to - The recipient address
   * @param amount - The amount of tokens to transfer
   */
  transfer(from: signer, to: address, amount: u64) {
    // Check sender has sufficient balance
    assert(Balance[from] >= amount, "Insufficient balance");

    // Deduct from sender
    Balance[from] = Balance[from] - amount;

    // Add to recipient (handle case where recipient has no balance yet)
    if (Balance[to] == null) {
      Balance[to] = amount;
    } else {
      Balance[to] = Balance[to] + amount;
    }
  }

  /**
   * Get balance for an address
   * @param addr - The address to query
   * @returns The token balance
   */
  function balanceOf(addr: address): u64 {
    return Balance[addr] || 0;
  }

  /**
   * Get total supply
   * @returns The total token supply
   */
  function getTotalSupply(): u64 {
    return TotalSupply[contract];
  }
}
