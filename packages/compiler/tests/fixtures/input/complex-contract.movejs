// Complex contract with multiple resources and functions
contract TokenBank {
  resource Balance { 
    amount: u64,
    locked: bool
  };
  
  resource Config {
    owner: address,
    fee: u64
  };
  
  deposit(account: signer, value: u64) {
    Balance[account] = value;
  }
  
  withdraw(account: address): u64 {
    return Balance[account];
  }
  
  calculate(x: u64, y: u64): u64 {
    return x + y * 10;
  }
}
